// ─── two-column table helper ─────────────────────────────────────────────────
function twoColTable(rows, col1W = 3000, col2W = 6360) {
  return new Table({
    width: { size: CONTENT_W, type: WidthType.DXA },
    columnWidths: [col1W, col2W],
    rows: rows.map(([left, right]) => new TableRow({
      children: [
        new TableCell({
          borders: borders(C.border),
          width: { size: col1W, type: WidthType.DXA },
          shading: { fill: C.bgAlt, type: ShadingType.CLEAR },
          margins: { top: 80, bottom: 80, left: 120, right: 120 },
          children: [new Paragraph({ children: [new TextRun({ text: left, font: 'Arial', size: 20, bold: true, color: C.tealDark })] })]
        }),
        new TableCell({
          borders: borders(C.border),
          width: { size: col2W, type: WidthType.DXA },
          margins: { top: 80, bottom: 80, left: 120, right: 120 },
          children: [new Paragraph({ children: [new TextRun({ text: right, font: 'Arial', size: 20, color: C.text })] })]
        })
      ]
    }))
  });
}

// ─── header row table helper ─────────────────────────────────────────────────
function headerTable(headers, rows, colWidths) {
  const total = colWidths.reduce((a, b) => a + b, 0);
  const headerRow = new TableRow({
    children: headers.map((h, i) => new TableCell({
      borders: borders(C.teal),
      width: { size: colWidths[i], type: WidthType.DXA },
      shading: { fill: C.teal, type: ShadingType.CLEAR },
      margins: { top: 80, bottom: 80, left: 120, right: 120 },
      children: [new Paragraph({ children: [new TextRun({ text: h, font: 'Arial', size: 20, bold: true, color: C.white })] })]
    }))
  });
  const dataRows = rows.map((row, ri) => new TableRow({
    children: row.map((cell, ci) => new TableCell({
      borders: borders(C.border),
      width: { size: colWidths[ci], type: WidthType.DXA },
      shading: { fill: ri % 2 === 0 ? C.white : C.bgAlt, type: ShadingType.CLEAR },
      margins: { top: 80, bottom: 80, left: 120, right: 120 },
      children: [new Paragraph({ children: [new TextRun({ text: cell, font: 'Arial', size: 20, color: C.text })] })]
    }))
  }));
  return new Table({
    width: { size: total, type: WidthType.DXA },
    columnWidths: colWidths,
    rows: [headerRow, ...dataRows]
  });
}

// ─── callout box ────────────────────────────────────────────────────────────
function callout(title, lines, bgColor = C.tealXLight, borderColor = C.teal, titleColor = C.tealDark) {
  const rows = [
    new TableRow({
      children: [new TableCell({
        borders: { top: border(borderColor), bottom: border(borderColor), left: { style: BorderStyle.SINGLE, size: 12, color: borderColor }, right: border(borderColor) },
        width: { size: CONTENT_W, type: WidthType.DXA },
        shading: { fill: bgColor, type: ShadingType.CLEAR },
        margins: { top: 100, bottom: 100, left: 160, right: 160 },
        children: [
          new Paragraph({ spacing: { before: 0, after: 80 }, children: [new TextRun({ text: title, font: 'Arial', size: 22, bold: true, color: titleColor })] }),
          ...lines.map(l => new Paragraph({ spacing: { before: 30, after: 30 }, children: [new TextRun({ text: l, font: 'Arial', size: 20, color: C.text })] }))
        ]
      })]
    })
  ];
  return new Table({ width: { size: CONTENT_W, type: WidthType.DXA }, columnWidths: [CONTENT_W], rows });
}

